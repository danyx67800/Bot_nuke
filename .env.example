# Porta della dashboard (default 4321)
PORT=4321
HOST=0.0.0.0

# Cartella persistente (config, token, sessione). In Docker: /data
DATA_DIR=./data

# Facoltativo: token del bot. Se vuoto lo inserisci dalla dashboard guidata.
DISCORD_TOKEN=

# Facoltativo: password iniziale della dashboard.
# Se impostata e la dashboard non ha ancora una password, viene usata come password iniziale.
DASHBOARD_PASSWORD=

# Metti a 1 se la dashboard è raggiungibile in HTTPS (cookie Secure).
COOKIE_SECURE=0

# Solo per sviluppo: 1 = Discord simulato, nessuna connessione reale.
MOCK_DISCORD=0

# Fuso orario usato per i template {time} / {date}
TZ=Europe/Rome
